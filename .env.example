# Variables d'environnement du proxy Vercel (NE JAMAIS committer .env réel).
# Copier en .env (local) et/ou configurer dans Vercel → Project → Settings → Environment Variables.

# Clé API Anthropic — détenue UNIQUEMENT côté serveur (proxy /api). SPEC §1/§3.
ANTHROPIC_API_KEY=sk-ant-...

# Modèle utilisé par le proxy (génération de leçons + résumé de veille). SPEC §1/§7.
CLAUDE_MODEL=claude-sonnet-4-6

# (Optionnel) Webhook de notification du rapport de veille (Slack/Discord/email-relay). SPEC §13.3.
VEILLE_WEBHOOK_URL=
